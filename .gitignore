# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Env / secrets
.env
*.token
neuprint_token*

# External repos (cloned reference code/data — not ours, too large, regenerable)
external/

# Data (connectome dumps, caches — too large / regenerable, never commit)
data/
*.parquet
*.feather
*.h5
*.hdf5

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store

# Media / renders (large binaries — keep source scripts, not output)
media/**/*.mp4
media/**/*.png
media/**/*.gif
media/**/*.json
!media/.gitkeep

# --- Preserved experiment records: DELIBERATELY tracked despite the rules
# above. The default is right for regenerable renders, but these are not
# cheaply regenerable:
#   * the Phase 5 pilot is ~5 hours of compute (121 generations);
#   * the contaminated first pilot CANNOT be reproduced at all, because the
#     code that produced it has since been fixed;
#   * the Phase 4 clips are the video deliverable and depend on specific
#     pilot replicate states.
# Inventory and provenance: docs/trained_adapter/artifacts/MANIFEST.md
!media/trained_adapter/**
!media/closed_loop/clips/**
# Baseline walking clips: the first thing in this project that actually
# walks (+14.4 mm/s, upright 1.000), plus the face-plant clips from our own
# rig as contrast. Video material and evidence for the rig diagnosis.
!media/baselines/**
!media/phase3_rerender/**
!media/closed_loop/*.json
!media/closed_loop/*/*.json

# MuJoCo / logs (root-anchored: does not affect docs/logs/, which is tracked)
*.mjb
/logs/
/outputs/
wandb/
